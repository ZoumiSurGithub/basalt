# Fins de ligne imposées, quel que soit le réglage de Git sur la machine :
# les scripts Linux doivent rester en LF (sinon « sh » les refuse), ceux de Windows en CRLF.
* text=auto
*.sh text eol=lf
*.rs text eol=lf
*.lua text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.service text eol=lf
Cargo.lock text eol=lf
*.cmd text eol=crlf
*.ps1 text eol=crlf
# Données binaires : jamais converties
*.bin binary
*.nbt binary
